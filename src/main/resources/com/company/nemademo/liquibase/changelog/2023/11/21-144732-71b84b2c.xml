<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1" author="NemaDemo">
        <createTable tableName="CLEARANCE_CERTIFICATES_REQUIREMENTS">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true"
                             primaryKeyName="PK_CLEARANCE_CERTIFICATES_REQUIREMENTS"/>
            </column>
            <column name="CERTIFICATE_NAME" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="CLEARANCE_CRITERIA" type="VARCHAR(255)"/>
            <column name="REQUIREMENTS" type="VARCHAR(255)"/>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="CREATED_BY" type="VARCHAR(255)"/>
            <column name="CREATED_DATE" type="timestamp with time zone"/>
            <column name="LAST_MODIFIED_BY" type="VARCHAR(255)"/>
            <column name="LAST_MODIFIED_DATE" type="timestamp with time zone"/>
        </createTable>
    </changeSet>
    <changeSet id="2" author="NemaDemo">
        <createTable tableName="CLEARANCE_CERTIFICATE_APPLICATION">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_CLEARANCE_CERTIFICATE_APPLICATION"/>
            </column>
            <column name="CERTIFICATE_TYPE_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="REFERENCE_NUMBER" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="FILE_REFERENCE_NUMBER" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="SECTION_HEAD_ID" type="UUID"/>
            <column name="REVIEWER_ID" type="UUID"/>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="CREATED_BY" type="VARCHAR(255)"/>
            <column name="CREATED_DATE" type="timestamp with time zone"/>
            <column name="LAST_MODIFIED_BY" type="VARCHAR(255)"/>
            <column name="LAST_MODIFIED_DATE" type="timestamp with time zone"/>
        </createTable>
    </changeSet>
    <changeSet id="3" author="NemaDemo">
        <createTable tableName="CLEARANCE_CERTIFICATE_REVIEW">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_CLEARANCE_CERTIFICATE_REVIEW"/>
            </column>
            <column name="CLEARANCE_CERT_APPLICATION_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="REVIEWER_ID" type="UUID"/>
            <column name="COMMENTS" type="VARCHAR(255)"/>
            <column name="RECOMMENDATION_STATUS_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="CREATED_BY" type="VARCHAR(255)"/>
            <column name="CREATED_DATE" type="timestamp with time zone"/>
            <column name="LAST_MODIFIED_BY" type="VARCHAR(255)"/>
            <column name="LAST_MODIFIED_DATE" type="timestamp with time zone"/>
        </createTable>
    </changeSet>
    <changeSet id="4" author="NemaDemo">
        <createIndex indexName="IDX_CLEARANCE_CERTIFICATE_APPLICATION_CERTIFICATE_TYPE"
                     tableName="CLEARANCE_CERTIFICATE_APPLICATION">
            <column name="CERTIFICATE_TYPE_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="CERTIFICATE_TYPE_ID" baseTableName="CLEARANCE_CERTIFICATE_APPLICATION"
                                 constraintName="FK_CLEARANCE_CERTIFICATE_APPLICATION_ON_CERTIFICATE_TYPE"
                                 referencedColumnNames="ID" referencedTableName="CLEARANCE_CERTIFICATES_REQUIREMENTS"/>
    </changeSet>
    <changeSet id="5" author="NemaDemo">
        <createIndex indexName="IDX_CLEARANCE_CERTIFICATE_APPLICATION_REVIEWER"
                     tableName="CLEARANCE_CERTIFICATE_APPLICATION">
            <column name="REVIEWER_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="REVIEWER_ID" baseTableName="CLEARANCE_CERTIFICATE_APPLICATION"
                                 constraintName="FK_CLEARANCE_CERTIFICATE_APPLICATION_ON_REVIEWER"
                                 referencedColumnNames="ID" referencedTableName="USER_"/>
    </changeSet>
    <changeSet id="6" author="NemaDemo">
        <createIndex indexName="IDX_CLEARANCE_CERTIFICATE_APPLICATION_SECTION_HEAD"
                     tableName="CLEARANCE_CERTIFICATE_APPLICATION">
            <column name="SECTION_HEAD_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="SECTION_HEAD_ID" baseTableName="CLEARANCE_CERTIFICATE_APPLICATION"
                                 constraintName="FK_CLEARANCE_CERTIFICATE_APPLICATION_ON_SECTION_HEAD"
                                 referencedColumnNames="ID" referencedTableName="USER_"/>
    </changeSet>
    <changeSet id="7" author="NemaDemo">
        <createIndex indexName="IDX_CLEARANCE_CERTIFICATE_REVIEW_CLEARANCE_CERT_APPLICATION"
                     tableName="CLEARANCE_CERTIFICATE_REVIEW">
            <column name="CLEARANCE_CERT_APPLICATION_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="CLEARANCE_CERT_APPLICATION_ID"
                                 baseTableName="CLEARANCE_CERTIFICATE_REVIEW"
                                 constraintName="FK_CLEARANCE_CERTIFICATE_REVIEW_ON_CLEARANCE_CERT_APPLICATION"
                                 referencedColumnNames="ID" referencedTableName="CLEARANCE_CERTIFICATE_APPLICATION"/>
    </changeSet>
    <changeSet id="8" author="NemaDemo">
        <createIndex indexName="IDX_CLEARANCE_CERTIFICATE_REVIEW_RECOMMENDATION_STATUS"
                     tableName="CLEARANCE_CERTIFICATE_REVIEW">
            <column name="RECOMMENDATION_STATUS_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="RECOMMENDATION_STATUS_ID" baseTableName="CLEARANCE_CERTIFICATE_REVIEW"
                                 constraintName="FK_CLEARANCE_CERTIFICATE_REVIEW_ON_RECOMMENDATION_STATUS"
                                 referencedColumnNames="ID" referencedTableName="RECOMMENDATION"/>
    </changeSet>
    <changeSet id="9" author="NemaDemo">
        <createIndex indexName="IDX_CLEARANCE_CERTIFICATE_REVIEW_REVIWER" tableName="CLEARANCE_CERTIFICATE_REVIEW">
            <column name="REVIEWER_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="REVIEWER_ID" baseTableName="CLEARANCE_CERTIFICATE_REVIEW"
                                 constraintName="FK_CLEARANCE_CERTIFICATE_REVIEW_ON_REVIEWER" referencedColumnNames="ID"
                                 referencedTableName="USER_"/>
    </changeSet>
</databaseChangeLog>
<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1" author="NemaDemo">
        <addColumn tableName="PERMITS_APPLICATION">
            <column name="REVIEWER_USER_ID" type="UUID"/>
            <column name="SECTION_HEAD_ID" type="UUID"/>
        </addColumn>
    </changeSet>
    <changeSet id="2" author="NemaDemo">
        <createIndex indexName="IDX_PERMITS_APPLICATION_REVIEWER_USER" tableName="PERMITS_APPLICATION">
            <column name="REVIEWER_USER_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="REVIEWER_USER_ID" baseTableName="PERMITS_APPLICATION"
                                 constraintName="FK_PERMITS_APPLICATION_ON_REVIEWER_USER" referencedColumnNames="ID"
                                 referencedTableName="USER_"/>
    </changeSet>
    <changeSet id="3" author="NemaDemo">
        <createIndex indexName="IDX_PERMITS_APPLICATION_SECTION_HEAD" tableName="PERMITS_APPLICATION">
            <column name="SECTION_HEAD_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="SECTION_HEAD_ID" baseTableName="PERMITS_APPLICATION"
                                 constraintName="FK_PERMITS_APPLICATION_ON_SECTION_HEAD" referencedColumnNames="ID"
                                 referencedTableName="USER_"/>
    </changeSet>
</databaseChangeLog>
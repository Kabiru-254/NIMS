<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://caseManagementListView.title"
      focusComponent="caseManagementsDataGrid">
    <data>
        <collection id="caseManagementsDc"
                    class="com.company.nemademo.entity.CaseManagement">
            <fetchPlan extends="_base">
                <property name="caseOwnerId" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="caseManagementsDl" readOnly="true">
                <query>
                    <![CDATA[select e from CaseManagement e]]>
                </query>
            </loader>
        </collection>
        <instance id="caseManagementDc"
                  class="com.company.nemademo.entity.CaseManagement">
            <fetchPlan extends="_base">
                <property name="caseOwnerId" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="caseManagementDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout padding="false">
        <formLayout classNames="master-detail-layout" height="100%">
            <vbox id="listLayout" height="100%">
                <genericFilter id="genericFilter"
                               dataLoader="caseManagementsDl">
                    <properties include=".*"/>
                </genericFilter>
                <hbox id="buttonsPanel" classNames="buttons-panel">
                    <button id="createBtn" action="caseManagementsDataGrid.create"/>
                    <button id="editBtn" action="caseManagementsDataGrid.edit"/>
                    <button id="removeBtn" action="caseManagementsDataGrid.remove"/>
                    <simplePagination id="pagination" dataLoader="caseManagementsDl"/>
                </hbox>
                <dataGrid id="caseManagementsDataGrid"
                          width="100%"
                          minHeight="20em"
                          dataContainer="caseManagementsDc"
                          columnReorderingAllowed="true">
                    <actions>
                        <action id="create" type="list_create"/>
                        <action id="edit" type="list_edit"/>
                        <action id="remove" type="list_remove"/>
                    </actions>
                    <columns resizable="true">
                        <column property="courtName"/>
                        <column property="dateInitiated"/>
                        <column property="referenceNumber"/>
                        <column property="caseType"/>
                        <column property="caseOwnerId"/>
                        <column property="caseResolutionDetails"/>
                    </columns>
                </dataGrid>
                <hbox id="lookupActions" visible="false">
                    <button id="selectBtn" action="selectAction"/>
                    <button id="discardBtn" action="discardAction"/>
                </hbox>
            </vbox>
            <vbox id="detailsLayout" height="100%">
                <formLayout id="form" dataContainer="caseManagementDc">
                    <textField id="courtNameField" property="courtName"/>
                    <datePicker id="dateInitiatedField" property="dateInitiated"/>
                    <textField id="referenceNumberField" property="referenceNumber"/>
                    <select id="caseTypeField" property="caseType"/>
                    <entityPicker id="caseOwnerIdField" property="caseOwnerId">
                        <actions>
                            <action id="entityLookup" type="entity_lookup"/>
                            <action id="entityClear" type="entity_clear"/>
                        </actions>
                    </entityPicker>
                    <textField id="caseResolutionDetailsField" property="caseResolutionDetails"/>
                </formLayout>
                <hbox id="detailActions">
                    <button id="saveBtn" text="msg:///actions.Save" icon="CHECK" themeNames="primary"/>
                    <button id="cancelBtn" text="msg:///actions.Cancel" icon="BAN"/>
                </hbox>
            </vbox>
        </formLayout>
    </layout>
</view>

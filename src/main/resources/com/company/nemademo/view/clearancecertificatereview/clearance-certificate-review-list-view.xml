<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://clearanceCertificateReviewListView.title"
      focusComponent="clearanceCertificateReviewsDataGrid">
    <data>
        <collection id="clearanceCertificateReviewsDc"
                    class="com.company.nemademo.entity.ClearanceCertificateReview">
            <fetchPlan extends="_base">
                <property name="clearanceCertApplicationId" fetchPlan="_base"/>
                <property name="reviewerId" fetchPlan="_base"/>
                <property name="recommendationStatusId" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="clearanceCertificateReviewsDl" readOnly="true">
                <query>
                    <![CDATA[select e from ClearanceCertificateReview e]]>
                </query>
            </loader>
        </collection>
        <instance id="clearanceCertificateReviewDc"
                  class="com.company.nemademo.entity.ClearanceCertificateReview">
            <fetchPlan extends="_base">
                <property name="clearanceCertApplicationId" fetchPlan="_base"/>
                <property name="reviewerId" fetchPlan="_base"/>
                <property name="recommendationStatusId" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="clearanceCertificateReviewDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout padding="false">
        <formLayout classNames="master-detail-layout" height="100%">
            <vbox id="listLayout" height="100%">
                <genericFilter id="genericFilter"
                               dataLoader="clearanceCertificateReviewsDl">
                    <properties include=".*"/>
                </genericFilter>
                <hbox id="buttonsPanel" classNames="buttons-panel">
                    <button id="createBtn" action="clearanceCertificateReviewsDataGrid.create"/>
                    <button id="editBtn" action="clearanceCertificateReviewsDataGrid.edit"/>
                    <button id="removeBtn" action="clearanceCertificateReviewsDataGrid.remove"/>
                    <simplePagination id="pagination" dataLoader="clearanceCertificateReviewsDl"/>
                </hbox>
                <dataGrid id="clearanceCertificateReviewsDataGrid"
                          width="100%"
                          minHeight="20em"
                          dataContainer="clearanceCertificateReviewsDc"
                          columnReorderingAllowed="true">
                    <actions>
                        <action id="create" type="list_create"/>
                        <action id="edit" type="list_edit"/>
                        <action id="remove" type="list_remove"/>
                    </actions>
                    <columns resizable="true">
                        <column property="clearanceCertApplicationId"/>
                        <column property="reviewerId"/>
                        <column property="comments"/>
                        <column property="recommendationStatusId"/>
                    </columns>
                </dataGrid>
                <hbox id="lookupActions" visible="false">
                    <button id="selectBtn" action="selectAction"/>
                    <button id="discardBtn" action="discardAction"/>
                </hbox>
            </vbox>
            <vbox id="detailsLayout" height="100%">
                <formLayout id="form" dataContainer="clearanceCertificateReviewDc">
                    <entityPicker id="clearanceCertApplicationIdField" property="clearanceCertApplicationId">
                        <actions>
                            <action id="entityLookup" type="entity_lookup"/>
                            <action id="entityClear" type="entity_clear"/>
                        </actions>
                    </entityPicker>
                    <entityPicker id="reviwerIdField" property="reviewerId">
                        <actions>
                            <action id="entityLookup" type="entity_lookup"/>
                            <action id="entityClear" type="entity_clear"/>
                        </actions>
                    </entityPicker>
                    <textField id="commentsField" property="comments"/>
                    <entityPicker id="recommendationStatusIdField" property="recommendationStatusId">
                        <actions>
                            <action id="entityLookup" type="entity_lookup"/>
                            <action id="entityClear" type="entity_clear"/>
                        </actions>
                    </entityPicker>
                </formLayout>
                <hbox id="detailActions">
                    <button id="saveBtn" text="msg:///actions.Save" icon="CHECK" themeNames="primary"/>
                    <button id="cancelBtn" text="msg:///actions.Cancel" icon="BAN"/>
                </hbox>
            </vbox>
        </formLayout>
    </layout>
</view>

<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://publicCommentsListView.title"
      focusComponent="publicCommentsesDataGrid">
    <data>
        <collection id="publicCommentsesDc"
                    class="com.company.nemademo.entity.PublicComments">
            <fetchPlan extends="_base"/>
            <loader id="publicCommentsesDl" readOnly="true">
                <query>
                    <![CDATA[select e from PublicComments e]]>
                </query>
            </loader>
        </collection>
        <instance id="publicCommentsDc"
                  class="com.company.nemademo.entity.PublicComments">
            <fetchPlan extends="_base"/>
            <loader id="publicCommentsDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout padding="false">
        <formLayout classNames="master-detail-layout" height="100%">
            <vbox id="listLayout" height="100%">
                <genericFilter id="genericFilter"
                               dataLoader="publicCommentsesDl">
                    <properties include=".*"/>
                </genericFilter>
                <hbox id="buttonsPanel" classNames="buttons-panel">
                    <button id="createBtn" action="publicCommentsesDataGrid.create"/>
                    <button id="editBtn" action="publicCommentsesDataGrid.edit"/>
                    <button id="removeBtn" action="publicCommentsesDataGrid.remove"/>
                    <simplePagination id="pagination" dataLoader="publicCommentsesDl"/>
                </hbox>
                <dataGrid id="publicCommentsesDataGrid"
                          width="100%"
                          minHeight="20em"
                          dataContainer="publicCommentsesDc"
                          columnReorderingAllowed="true">
                    <actions>
                        <action id="create" type="list_create"/>
                        <action id="edit" type="list_edit"/>
                        <action id="remove" type="list_remove"/>
                    </actions>
                    <columns resizable="true">
                        <column property="projectFileNumber"/>
                        <column property="name"/>
                        <column property="phoneNumber"/>
                        <column property="emailAddress"/>
                        <column property="comments"/>
                    </columns>
                </dataGrid>
                <hbox id="lookupActions" visible="false">
                    <button id="selectBtn" action="selectAction"/>
                    <button id="discardBtn" action="discardAction"/>
                </hbox>
            </vbox>
            <vbox id="detailsLayout" height="100%">
                <formLayout id="form" dataContainer="publicCommentsDc">
                    <textField id="projectFileNumberField" property="projectFileNumber"/>
                    <textField id="nameField" property="name"/>
                    <textField id="phoneNumberField" property="phoneNumber"/>
                    <textField id="emailAddressField" property="emailAddress"/>
                    <textField id="commentsField" property="comments"/>
                </formLayout>
                <hbox id="detailActions">
                    <button id="saveBtn" text="msg:///actions.Save" icon="CHECK" themeNames="primary"/>
                    <button id="cancelBtn" text="msg:///actions.Cancel" icon="BAN"/>
                </hbox>
            </vbox>
        </formLayout>
    </layout>
</view>

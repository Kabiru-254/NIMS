                    <properties include=".*"/>
                </genericFilter>
                <hbox id="buttonsPanel" classNames="buttons-panel">
                    <button id="createBtn" action="clearanceCertificatesRequirementsesDataGrid.create"/>
                    <button id="editBtn" action="clearanceCertificatesRequirementsesDataGrid.edit"/>
                    <button id="removeBtn" action="clearanceCertificatesRequirementsesDataGrid.remove"/>
                    <simplePagination id="pagination" dataLoader="clearanceCertificatesRequirementsesDl"/>
                </hbox>
                <dataGrid id="clearanceCertificatesRequirementsesDataGrid"
                          width="100%"
                          minHeight="20em"
                          dataContainer="clearanceCertificatesRequirementsesDc"
                          columnReorderingAllowed="true">
                    <actions>
                        <action id="create" type="list_create"/>
                        <action id="edit" type="list_edit"/>
                        <action id="remove" type="list_remove"/>
                    </actions>
                    <columns resizable="true">

<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://clearanceCertificatesRequirementsListView.title"
      focusComponent="clearanceCertificatesRequirementsesDataGrid">
    <data>
        <collection id="clearanceCertificatesRequirementsesDc"
                    class="com.company.nemademo.entity.ClearanceCertificatesRequirements">
            <fetchPlan extends="_base"/>
            <loader id="clearanceCertificatesRequirementsesDl" readOnly="true">
                <query>
                    <![CDATA[select e from ClearanceCertificatesRequirements e]]>
                </query>
            </loader>
        </collection>
        <instance id="clearanceCertificatesRequirementsDc"
                  class="com.company.nemademo.entity.ClearanceCertificatesRequirements">
            <fetchPlan extends="_base"/>
            <loader id="clearanceCertificatesRequirementsDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>

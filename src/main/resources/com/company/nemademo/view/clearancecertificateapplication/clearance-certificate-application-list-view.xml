<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://clearanceCertificateApplicationListView.title"
      focusComponent="clearanceCertificateApplicationsDataGrid">
    <data>
        <collection id="clearanceCertificateApplicationsDc"
                    class="com.company.nemademo.entity.ClearanceCertificateApplication">
            <fetchPlan extends="_base">
                <property name="certificateTypeId" fetchPlan="_base"/>
                <property name="sectionHeadId" fetchPlan="_base"/>
                <property name="reviewerId" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="clearanceCertificateApplicationsDl" readOnly="true">
                <query>
                    <![CDATA[select e from ClearanceCertificateApplication e]]>
                </query>
            </loader>
        </collection>
        <instance id="clearanceCertificateApplicationDc"
                  class="com.company.nemademo.entity.ClearanceCertificateApplication">
            <fetchPlan extends="_base">
                <property name="certificateTypeId" fetchPlan="_base"/>
                <property name="sectionHeadId" fetchPlan="_base"/>
                <property name="reviewerId" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="clearanceCertificateApplicationDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout padding="false">
        <formLayout classNames="master-detail-layout" height="100%">
            <vbox id="listLayout" height="100%">
                <genericFilter id="genericFilter"
                               dataLoader="clearanceCertificateApplicationsDl">
                    <properties include=".*"/>
                </genericFilter>
                <hbox id="buttonsPanel" classNames="buttons-panel">
                    <button id="createBtn" action="clearanceCertificateApplicationsDataGrid.create"/>
                    <button id="editBtn" action="clearanceCertificateApplicationsDataGrid.edit"/>
                    <button id="removeBtn" action="clearanceCertificateApplicationsDataGrid.remove"/>
                    <simplePagination id="pagination" dataLoader="clearanceCertificateApplicationsDl"/>
                </hbox>
                <dataGrid id="clearanceCertificateApplicationsDataGrid"
                          width="100%"
                          minHeight="20em"
                          dataContainer="clearanceCertificateApplicationsDc"
                          columnReorderingAllowed="true">
                    <actions>
                        <action id="create" type="list_create"/>
                        <action id="edit" type="list_edit"/>
                        <action id="remove" type="list_remove"/>
                    </actions>
                    <columns resizable="true">
                        <column property="certificateTypeId"/>
                        <column property="referenceNumber"/>
                        <column property="fileReferenceNumber"/>
                        <column property="sectionHeadId"/>
                        <column property="reviewerId"/>
                    </columns>
                </dataGrid>
                <hbox id="lookupActions" visible="false">
                    <button id="selectBtn" action="selectAction"/>
                    <button id="discardBtn" action="discardAction"/>
                </hbox>
            </vbox>
            <vbox id="detailsLayout" height="100%">
                <formLayout id="form" dataContainer="clearanceCertificateApplicationDc">
                    <entityPicker id="certificateTypeIdField" property="certificateTypeId">
                        <actions>
                            <action id="entityLookup" type="entity_lookup"/>
                            <action id="entityClear" type="entity_clear"/>
                        </actions>
                    </entityPicker>
                    <textField id="referenceNumberField" property="referenceNumber"/>
                    <textField id="fileReferenceNumberField" property="fileReferenceNumber"/>
                    <entityPicker id="sectionHeadIdField" property="sectionHeadId">
                        <actions>
                            <action id="entityLookup" type="entity_lookup"/>
                            <action id="entityClear" type="entity_clear"/>
                        </actions>
                    </entityPicker>
                    <entityPicker id="reviewerIdField" property="reviewerId">
                        <actions>
                            <action id="entityLookup" type="entity_lookup"/>
                            <action id="entityClear" type="entity_clear"/>
                        </actions>
                    </entityPicker>
                </formLayout>
                <hbox id="detailActions">
                    <button id="saveBtn" text="msg:///actions.Save" icon="CHECK" themeNames="primary"/>
                    <button id="cancelBtn" text="msg:///actions.Cancel" icon="BAN"/>
                </hbox>
            </vbox>
        </formLayout>
    </layout>
</view>

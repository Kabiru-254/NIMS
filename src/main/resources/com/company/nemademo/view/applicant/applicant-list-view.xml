<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://applicantListView.title"
      focusComponent="applicantsDataGrid">
    <data>
        <collection id="applicantsDc"
                    class="com.company.nemademo.entity.Applicant">
            <fetchPlan extends="_base">
                <property name="applicationCategoryId" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="applicantsDl" readOnly="true">
                <query>
                    <![CDATA[select e from Applicant e]]>
                </query>
            </loader>
        </collection>
        <instance id="applicantDc"
                  class="com.company.nemademo.entity.Applicant">
            <fetchPlan extends="_base">
                <property name="applicationCategoryId" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="applicantDl"/>
        </instance>
        <collection id="applicationCategoryDc" class="com.company.nemademo.entity.ApplicationCategory">
            <fetchPlan extends="_base"/>
            <loader id="applicationCategoryDl">
                <query>
                    <![CDATA[select e from ApplicationCategory e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout padding="false">
        <formLayout classNames="master-detail-layout" height="100%">
            <vbox id="listLayout" height="100%">
                <genericFilter id="genericFilter"
                               dataLoader="applicantsDl">
                    <properties include=".*"/>
                </genericFilter>
                <hbox id="buttonsPanel" classNames="buttons-panel">
                    <button id="createBtn" action="applicantsDataGrid.create"/>
                    <button id="editBtn" action="applicantsDataGrid.edit"/>
                    <button id="removeBtn" action="applicantsDataGrid.remove"/>
                    <simplePagination id="pagination" dataLoader="applicantsDl"/>
                </hbox>
                <dataGrid id="applicantsDataGrid"
                          width="100%"
                          minHeight="20em"
                          dataContainer="applicantsDc"
                          columnReorderingAllowed="true">
                    <actions>
                        <action id="create" type="list_create"/>
                        <action id="edit" type="list_edit"/>
                        <action id="remove" type="list_remove"/>
                    </actions>
                    <columns resizable="true">
                        <column property="firstName"/>
                        <column property="lastName"/>
                        <column property="applicationCategoryId"/>
                        <column property="applicantType"/>
                        <column property="kraPin"/>
                        <column property="emailAddress"/>
                        <column property="physicalAddress"/>
                        <column property="postalCode"/>
                        <column property="postalTown"/>
                    </columns>
                </dataGrid>
                <hbox id="lookupActions" visible="false">
                    <button id="selectBtn" action="selectAction"/>
                    <button id="discardBtn" action="discardAction"/>
                </hbox>
            </vbox>
            <vbox id="detailsLayout" height="100%">
                <formLayout id="form" dataContainer="applicantDc">
                    <textField id="firstNameField" property="firstName"/>
                    <textField id="lastNameField" property="lastName"/>
                    <entityComboBox id="applicationCategoryIdField" property="applicationCategoryId" dataContainer="applicantDc"
                                    itemsContainer="applicationCategoryDc"
                                    label="msg://applicationCategoryIdField.label">
                        <actions>
                            <action id="entityClear" type="entity_clear"/>
                        </actions>
                    </entityComboBox>
                    <select id="applicantTypeField" property="applicantType" label="msg://applicantTypeField.label"/>
                    <textField id="kraPinField" property="kraPin"/>
                    <textField id="emailAddressField" property="emailAddress"/>
                    <textField id="physicalAddressField" property="physicalAddress"/>
                    <textField id="postalCodeField" property="postalCode"/>
                    <textField id="postalTownField" property="postalTown"/>
                </formLayout>
                <hbox id="detailActions">
                    <button id="saveBtn" text="msg:///actions.Save" icon="CHECK" themeNames="primary"/>
                    <button id="cancelBtn" text="msg:///actions.Cancel" icon="BAN"/>
                </hbox>
            </vbox>
        </formLayout>
    </layout>
</view>

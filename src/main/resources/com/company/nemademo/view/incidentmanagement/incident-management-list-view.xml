<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://incidentManagementListView.title"
      focusComponent="incidentManagementsDataGrid">
    <data>
        <collection id="incidentManagementsDc"
                    class="com.company.nemademo.entity.IncidentManagement">
            <fetchPlan extends="_base">
                <property name="incidentStatusId" fetchPlan="_base"/>
                <property name="incidentCategoryId" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="incidentManagementsDl" readOnly="true">
                <query>
                    <![CDATA[select e from IncidentManagement e]]>
                </query>
            </loader>
        </collection>
        <instance id="incidentManagementDc"
                  class="com.company.nemademo.entity.IncidentManagement">
            <fetchPlan extends="_base">
                <property name="incidentStatusId" fetchPlan="_base"/>
                <property name="incidentCategoryId" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="incidentManagementDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout padding="false">
        <formLayout classNames="master-detail-layout" height="100%">
            <vbox id="listLayout" height="100%">
                <genericFilter id="genericFilter"
                               dataLoader="incidentManagementsDl">
                    <properties include=".*"/>
                </genericFilter>
                <hbox id="buttonsPanel" classNames="buttons-panel">
                    <button id="createBtn" action="incidentManagementsDataGrid.create"/>
                    <button id="editBtn" action="incidentManagementsDataGrid.edit"/>
                    <button id="removeBtn" action="incidentManagementsDataGrid.remove"/>
                    <simplePagination id="pagination" dataLoader="incidentManagementsDl"/>
                </hbox>
                <dataGrid id="incidentManagementsDataGrid"
                          width="100%"
                          minHeight="20em"
                          dataContainer="incidentManagementsDc"
                          columnReorderingAllowed="true">
                    <actions>
                        <action id="create" type="list_create"/>
                        <action id="edit" type="list_edit"/>
                        <action id="remove" type="list_remove"/>
                    </actions>
                    <columns resizable="true">
                        <column property="incidentNumber"/>
                        <column property="incidentSummary"/>
                        <column property="incidentClassification"/>
                        <column property="incidentDetails"/>
                        <column property="clientName"/>
                        <column property="clientPhoneNumber"/>
                        <column property="clientEmailAddress"/>
                        <column property="incidentDate"/>
                        <column property="assignedOfficerId"/>
                        <column property="officerNotes"/>
                        <column property="incidentStatusId"/>
                        <column property="incidentCategoryId"/>
                    </columns>
                </dataGrid>
                <hbox id="lookupActions" visible="false">
                    <button id="selectBtn" action="selectAction"/>
                    <button id="discardBtn" action="discardAction"/>
                </hbox>
            </vbox>
            <vbox id="detailsLayout" height="100%">
                <formLayout id="form" dataContainer="incidentManagementDc">
                    <textField id="incidentNumberField" property="incidentNumber"/>
                    <textField id="incidentSummaryField" property="incidentSummary"/>
                    <select id="incidentClassificationField" property="incidentClassification"/>
                    <textField id="incidentDetailsField" property="incidentDetails"/>
                    <textField id="clientNameField" property="clientName"/>
                    <textField id="clientPhoneNumberField" property="clientPhoneNumber"/>
                    <textField id="clientEmailAddressField" property="clientEmailAddress"/>
                    <datePicker id="incidentDateField" property="incidentDate"/>
                    <textField id="assignedOfficerIdField" property="assignedOfficerId"/>
                    <textField id="officerNotesField" property="officerNotes"/>
                    <entityPicker id="incidentStatusIdField" property="incidentStatusId">
                        <actions>
                            <action id="entityLookup" type="entity_lookup"/>
                            <action id="entityClear" type="entity_clear"/>
                        </actions>
                    </entityPicker>
                    <entityPicker id="incidentCategoryIdField" property="incidentCategoryId">
                        <actions>
                            <action id="entityLookup" type="entity_lookup"/>
                            <action id="entityClear" type="entity_clear"/>
                        </actions>
                    </entityPicker>
                </formLayout>
                <hbox id="detailActions">
                    <button id="saveBtn" text="msg:///actions.Save" icon="CHECK" themeNames="primary"/>
                    <button id="cancelBtn" text="msg:///actions.Cancel" icon="BAN"/>
                </hbox>
            </vbox>
        </formLayout>
    </layout>
</view>

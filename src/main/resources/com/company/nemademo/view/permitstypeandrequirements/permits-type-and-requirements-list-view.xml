<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://permitsTypeAndRequirementsListView.title"
      focusComponent="permitsTypeAndRequirementsesDataGrid">
    <data>
        <collection id="permitsTypeAndRequirementsesDc"
                    class="com.company.nemademo.entity.PermitsTypeAndRequirements">
            <fetchPlan extends="_base"/>
            <loader id="permitsTypeAndRequirementsesDl" readOnly="true">
                <query>
                    <![CDATA[select e from PermitsTypeAndRequirements e]]>
                </query>
            </loader>
        </collection>
        <instance id="permitsTypeAndRequirementsDc"
                  class="com.company.nemademo.entity.PermitsTypeAndRequirements">
            <fetchPlan extends="_base"/>
            <loader id="permitsTypeAndRequirementsDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout padding="false">
        <formLayout classNames="master-detail-layout" height="100%">
            <vbox id="listLayout" height="100%">
                <genericFilter id="genericFilter"
                               dataLoader="permitsTypeAndRequirementsesDl">
                    <properties include=".*"/>
                </genericFilter>
                <hbox id="buttonsPanel" classNames="buttons-panel">
                    <button id="createBtn" action="permitsTypeAndRequirementsesDataGrid.create"/>
                    <button id="editBtn" action="permitsTypeAndRequirementsesDataGrid.edit"/>
                    <button id="removeBtn" action="permitsTypeAndRequirementsesDataGrid.remove"/>
                    <simplePagination id="pagination" dataLoader="permitsTypeAndRequirementsesDl"/>
                </hbox>
                <dataGrid id="permitsTypeAndRequirementsesDataGrid"
                          width="100%"
                          minHeight="20em"
                          dataContainer="permitsTypeAndRequirementsesDc"
                          columnReorderingAllowed="true">
                    <actions>
                        <action id="create" type="list_create"/>
                        <action id="edit" type="list_edit"/>
                        <action id="remove" type="list_remove"/>
                    </actions>
                    <columns resizable="true">
                        <column property="permitName"/>
                        <column property="requirements"/>
                    </columns>
                </dataGrid>
                <hbox id="lookupActions" visible="false">
                    <button id="selectBtn" action="selectAction"/>
                    <button id="discardBtn" action="discardAction"/>
                </hbox>
            </vbox>
            <vbox id="detailsLayout" height="100%">
                <formLayout id="form" dataContainer="permitsTypeAndRequirementsDc">
                    <textField id="permitNameField" property="permitName"/>
                    <textField id="requirementsField" property="requirements"/>
                </formLayout>
                <hbox id="detailActions">
                    <button id="saveBtn" text="msg:///actions.Save" icon="CHECK" themeNames="primary"/>
                    <button id="cancelBtn" text="msg:///actions.Cancel" icon="BAN"/>
                </hbox>
            </vbox>
        </formLayout>
    </layout>
</view>

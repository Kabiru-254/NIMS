<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://caseOwnerAdvocatesListView.title"
      focusComponent="caseOwnerAdvocatesesDataGrid">
    <data>
        <collection id="caseOwnerAdvocatesesDc"
                    class="com.company.nemademo.entity.CaseOwnerAdvocates">
            <fetchPlan extends="_base"/>
            <loader id="caseOwnerAdvocatesesDl" readOnly="true">
                <query>
                    <![CDATA[select e from CaseOwnerAdvocates e]]>
                </query>
            </loader>
        </collection>
        <instance id="caseOwnerAdvocatesDc"
                  class="com.company.nemademo.entity.CaseOwnerAdvocates">
            <fetchPlan extends="_base"/>
            <loader id="caseOwnerAdvocatesDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout padding="false">
        <formLayout classNames="master-detail-layout" height="100%">
            <vbox id="listLayout" height="100%">
                <genericFilter id="genericFilter"
                               dataLoader="caseOwnerAdvocatesesDl">
                    <properties include=".*"/>
                </genericFilter>
                <hbox id="buttonsPanel" classNames="buttons-panel">
                    <button id="createBtn" action="caseOwnerAdvocatesesDataGrid.create"/>
                    <button id="editBtn" action="caseOwnerAdvocatesesDataGrid.edit"/>
                    <button id="removeBtn" action="caseOwnerAdvocatesesDataGrid.remove"/>
                    <simplePagination id="pagination" dataLoader="caseOwnerAdvocatesesDl"/>
                </hbox>
                <dataGrid id="caseOwnerAdvocatesesDataGrid"
                          width="100%"
                          minHeight="20em"
                          dataContainer="caseOwnerAdvocatesesDc"
                          columnReorderingAllowed="true">
                    <actions>
                        <action id="create" type="list_create"/>
                        <action id="edit" type="list_edit"/>
                        <action id="remove" type="list_remove"/>
                    </actions>
                    <columns resizable="true">
                        <column property="firstName"/>
                        <column property="lastName"/>
                        <column property="qualifications"/>
                    </columns>
                </dataGrid>
                <hbox id="lookupActions" visible="false">
                    <button id="selectBtn" action="selectAction"/>
                    <button id="discardBtn" action="discardAction"/>
                </hbox>
            </vbox>
            <vbox id="detailsLayout" height="100%">
                <formLayout id="form" dataContainer="caseOwnerAdvocatesDc">
                    <textField id="firstNameField" property="firstName"/>
                    <textField id="lastNameField" property="lastName"/>
                    <textField id="qualificationsField" property="qualifications"/>
                </formLayout>
                <hbox id="detailActions">
                    <button id="saveBtn" text="msg:///actions.Save" icon="CHECK" themeNames="primary"/>
                    <button id="cancelBtn" text="msg:///actions.Cancel" icon="BAN"/>
                </hbox>
            </vbox>
        </formLayout>
    </layout>
</view>

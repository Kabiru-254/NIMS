<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://casePartiesInvolvedListView.title"
      focusComponent="casePartiesInvolvedsDataGrid">
    <data>
        <collection id="casePartiesInvolvedsDc"
                    class="com.company.nemademo.entity.CasePartiesInvolved">
            <fetchPlan extends="_base">
                <property name="caseId" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="casePartiesInvolvedsDl" readOnly="true">
                <query>
                    <![CDATA[select e from CasePartiesInvolved e]]>
                </query>
            </loader>
        </collection>
        <instance id="casePartiesInvolvedDc"
                  class="com.company.nemademo.entity.CasePartiesInvolved">
            <fetchPlan extends="_base">
                <property name="caseId" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="casePartiesInvolvedDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout padding="false">
        <formLayout classNames="master-detail-layout" height="100%">
            <vbox id="listLayout" height="100%">
                <genericFilter id="genericFilter"
                               dataLoader="casePartiesInvolvedsDl">
                    <properties include=".*"/>
                </genericFilter>
                <hbox id="buttonsPanel" classNames="buttons-panel">
                    <button id="createBtn" action="casePartiesInvolvedsDataGrid.create"/>
                    <button id="editBtn" action="casePartiesInvolvedsDataGrid.edit"/>
                    <button id="removeBtn" action="casePartiesInvolvedsDataGrid.remove"/>
                    <simplePagination id="pagination" dataLoader="casePartiesInvolvedsDl"/>
                </hbox>
                <dataGrid id="casePartiesInvolvedsDataGrid"
                          width="100%"
                          minHeight="20em"
                          dataContainer="casePartiesInvolvedsDc"
                          columnReorderingAllowed="true">
                    <actions>
                        <action id="create" type="list_create"/>
                        <action id="edit" type="list_edit"/>
                        <action id="remove" type="list_remove"/>
                    </actions>
                    <columns resizable="true">
                        <column property="caseId"/>
                        <column property="name"/>
                        <column property="designation"/>
                    </columns>
                </dataGrid>
                <hbox id="lookupActions" visible="false">
                    <button id="selectBtn" action="selectAction"/>
                    <button id="discardBtn" action="discardAction"/>
                </hbox>
            </vbox>
            <vbox id="detailsLayout" height="100%">
                <formLayout id="form" dataContainer="casePartiesInvolvedDc">
                    <entityPicker id="caseIdField" property="caseId">
                        <actions>
                            <action id="entityLookup" type="entity_lookup"/>
                            <action id="entityClear" type="entity_clear"/>
                        </actions>
                    </entityPicker>
                    <textField id="nameField" property="name"/>
                    <textField id="designationField" property="designation"/>
                </formLayout>
                <hbox id="detailActions">
                    <button id="saveBtn" text="msg:///actions.Save" icon="CHECK" themeNames="primary"/>
                    <button id="cancelBtn" text="msg:///actions.Cancel" icon="BAN"/>
                </hbox>
            </vbox>
        </formLayout>
    </layout>
</view>

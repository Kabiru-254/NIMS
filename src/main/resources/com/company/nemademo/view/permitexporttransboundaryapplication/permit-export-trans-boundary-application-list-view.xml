<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://permitExportTransBoundaryApplicationListView.title"
      focusComponent="permitExportTransBoundaryApplicationsDataGrid">
    <data>
        <collection id="permitExportTransBoundaryApplicationsDc"
                    class="com.company.nemademo.entity.PermitExportTransBoundaryApplication">
            <fetchPlan extends="_base">
                <property name="permitApplicationId" fetchPlan="_instance_name">
                    <property name="referenceNumber"/>
                </property>
                <property name="permitApplicantId" fetchPlan="_instance_name">
                    <property name="lastName"/>
                </property>
            </fetchPlan>
            <loader id="permitExportTransBoundaryApplicationsDl" readOnly="true">
                <query>
                    <![CDATA[select e from PermitExportTransBoundaryApplication e]]>
                </query>
            </loader>
        </collection>
        <instance id="permitExportTransBoundaryApplicationDc"
                  class="com.company.nemademo.entity.PermitExportTransBoundaryApplication">
            <fetchPlan extends="_base">
                <property name="permitApplicationId" fetchPlan="_instance_name">
                    <property name="referenceNumber"/>
                </property>
                <property name="permitApplicantId" fetchPlan="_instance_name">
                    <property name="lastName"/>
                </property>
            </fetchPlan>
            <loader id="permitExportTransBoundaryApplicationDl"/>
        </instance>
        <collection id="permitApplicationDc" class="com.company.nemademo.entity.PermitsApplication">
            <fetchPlan extends="_base"/>
            <loader id="permitApplicationDl">
                <query>
                    <![CDATA[select e from PermitsApplication e]]>
                </query>
            </loader>
        </collection>
        <collection id="permitApplicantDc" class="com.company.nemademo.entity.PermitApplicant">
            <fetchPlan extends="_base"/>
            <loader id="permitApplicantDl">
                <query>
                    <![CDATA[select e from PermitApplicant e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout padding="false">
        <formLayout classNames="master-detail-layout" height="100%">
            <vbox id="listLayout" height="100%">
                <genericFilter id="genericFilter"
                               dataLoader="permitExportTransBoundaryApplicationsDl">
                    <properties include=".*"/>
                </genericFilter>
                <hbox id="buttonsPanel" classNames="buttons-panel">
                    <button id="createBtn" action="permitExportTransBoundaryApplicationsDataGrid.create"/>
                    <button id="editBtn" action="permitExportTransBoundaryApplicationsDataGrid.edit"/>
                    <button id="removeBtn" action="permitExportTransBoundaryApplicationsDataGrid.remove"/>
                    <simplePagination id="pagination" dataLoader="permitExportTransBoundaryApplicationsDl"/>
                </hbox>
                <dataGrid id="permitExportTransBoundaryApplicationsDataGrid"
                          width="100%"
                          minHeight="20em"
                          dataContainer="permitExportTransBoundaryApplicationsDc"
                          columnReorderingAllowed="true">
                    <actions>
                        <action id="create" type="list_create"/>
                        <action id="edit" type="list_edit"/>
                        <action id="remove" type="list_remove"/>
                    </actions>
                    <columns resizable="true">
                        <column property="permitApplicationId"/>
                        <column property="exporterName"/>
                        <column property="exporterAddress"/>
                        <column property="destinationName"/>
                        <column property="wasteToBeTransported"/>
                        <column property="permitApplicantId"/>
                        <column property="destinationAddress"/>
                    </columns>
                </dataGrid>
                <hbox id="lookupActions" visible="false">
                    <button id="selectBtn" action="selectAction"/>
                    <button id="discardBtn" action="discardAction"/>
                </hbox>
            </vbox>
            <vbox id="detailsLayout" height="100%">
                <formLayout id="form" dataContainer="permitExportTransBoundaryApplicationDc">
                    <entityComboBox id="permitApplicationIdField" property="permitApplicationId"
                    dataContainer="permitExportTransBoundaryApplicationDc" itemsContainer="permitApplicationDc"
                                    label="msg://permitApplicationIdField.label">
                        <actions>
                            <action id="entityClear" type="entity_clear"/>
                        </actions>
                    </entityComboBox>
                    <textField id="exporterNameField" property="exporterName"/>
                    <textField id="exporterAddressField" property="exporterAddress"/>
                    <textField id="destinationNameField" property="destinationName"/>
                    <textField id="wasteToBeTransportedField" property="wasteToBeTransported"/>
                    <entityComboBox id="permitApplicantIdField" property="permitApplicantId"
                    dataContainer="permitExportTransBoundaryApplicationDc" itemsContainer="permitApplicantDc"
                                    label="msg://permitApplicantIdField.label">
                        <actions>
                            <action id="entityClear" type="entity_clear"/>
                        </actions>
                    </entityComboBox>
                    <textField id="destinationAddressField" property="destinationAddress"/>
                </formLayout>
                <hbox id="detailActions">
                    <button id="saveBtn" text="msg:///actions.Save" icon="CHECK" themeNames="primary"/>
                    <button id="cancelBtn" text="msg:///actions.Cancel" icon="BAN"/>
                </hbox>
            </vbox>
        </formLayout>
    </layout>
</view>

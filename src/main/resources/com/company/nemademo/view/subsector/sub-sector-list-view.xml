<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://subSectorListView.title"
      focusComponent="subSectorsDataGrid">
    <data>
        <collection id="subSectorsDc"
                    class="com.company.nemademo.entity.SubSector">
            <fetchPlan extends="_base">
                <property name="sectorId" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="subSectorsDl" readOnly="true">
                <query>
                    <![CDATA[select e from SubSector e]]>
                </query>
            </loader>
        </collection>
        <instance id="subSectorDc"
                  class="com.company.nemademo.entity.SubSector">
            <fetchPlan extends="_base">
                <property name="sectorId" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="subSectorDl"/>
        </instance>
        <collection id="sectorDc" class="com.company.nemademo.entity.Sector">
            <fetchPlan extends="_base"/>
            <loader id="sectorDl">
                <query>
                    <![CDATA[select e from Sector e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout padding="false">
        <formLayout classNames="master-detail-layout" height="100%">
            <vbox id="listLayout" height="100%">
                <genericFilter id="genericFilter"
                               dataLoader="subSectorsDl">
                    <properties include=".*"/>
                </genericFilter>
                <hbox id="buttonsPanel" classNames="buttons-panel">
                    <button id="createBtn" action="subSectorsDataGrid.create"/>
                    <button id="editBtn" action="subSectorsDataGrid.edit"/>
                    <button id="removeBtn" action="subSectorsDataGrid.remove"/>
                    <simplePagination id="pagination" dataLoader="subSectorsDl"/>
                </hbox>
                <dataGrid id="subSectorsDataGrid"
                          width="100%"
                          minHeight="20em"
                          dataContainer="subSectorsDc"
                          columnReorderingAllowed="true">
                    <actions>
                        <action id="create" type="list_create"/>
                        <action id="edit" type="list_edit"/>
                        <action id="remove" type="list_remove"/>
                    </actions>
                    <columns resizable="true">
                        <column property="sectorId"/>
                        <column property="subSectorName"/>
                        <column property="description"/>
                    </columns>
                </dataGrid>
                <hbox id="lookupActions" visible="false">
                    <button id="selectBtn" action="selectAction"/>
                    <button id="discardBtn" action="discardAction"/>
                </hbox>
            </vbox>
            <vbox id="detailsLayout" height="100%">
                <formLayout id="form" dataContainer="subSectorDc">
                    <entityComboBox id="sectorIdField" property="sectorId"
                    dataContainer="subSectorDc" itemsContainer="sectorDc"
                                    label="msg://sectorIdField.label">
                        <actions>
                            <action id="entityClear" type="entity_clear"/>
                        </actions>
                    </entityComboBox>
                    <textField id="subSectorNameField" property="subSectorName"/>
                    <textField id="descriptionField" property="description"/>
                </formLayout>
                <hbox id="detailActions">
                    <button id="saveBtn" text="msg:///actions.Save" icon="CHECK" themeNames="primary"/>
                    <button id="cancelBtn" text="msg:///actions.Cancel" icon="BAN"/>
                </hbox>
            </vbox>
        </formLayout>
    </layout>
</view>

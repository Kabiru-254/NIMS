<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://toxicHarzadRequirementsListView.title"
      focusComponent="toxicHarzadRequirementsesDataGrid">
    <data>
        <collection id="toxicHarzadRequirementsesDc"
                    class="com.company.nemademo.entity.ToxicHarzadRequirements">
            <fetchPlan extends="_base"/>
            <loader id="toxicHarzadRequirementsesDl" readOnly="true">
                <query>
                    <![CDATA[select e from ToxicHarzadRequirements e]]>
                </query>
            </loader>
        </collection>
        <instance id="toxicHarzadRequirementsDc"
                  class="com.company.nemademo.entity.ToxicHarzadRequirements">
            <fetchPlan extends="_base"/>
            <loader id="toxicHarzadRequirementsDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout padding="false">
        <formLayout classNames="master-detail-layout" height="100%">
            <vbox id="listLayout" height="100%">
                <genericFilter id="genericFilter"
                               dataLoader="toxicHarzadRequirementsesDl">
                    <properties include=".*"/>
                </genericFilter>
                <hbox id="buttonsPanel" classNames="buttons-panel">
                    <button id="createBtn" action="toxicHarzadRequirementsesDataGrid.create"/>
                    <button id="editBtn" action="toxicHarzadRequirementsesDataGrid.edit"/>
                    <button id="removeBtn" action="toxicHarzadRequirementsesDataGrid.remove"/>
                    <simplePagination id="pagination" dataLoader="toxicHarzadRequirementsesDl"/>
                </hbox>
                <dataGrid id="toxicHarzadRequirementsesDataGrid"
                          width="100%"
                          minHeight="20em"
                          dataContainer="toxicHarzadRequirementsesDc"
                          columnReorderingAllowed="true">
                    <actions>
                        <action id="create" type="list_create"/>
                        <action id="edit" type="list_edit"/>
                        <action id="remove" type="list_remove"/>
                    </actions>
                    <columns resizable="true">
                        <column property="chemicalOrMaterial"/>
                        <column property="criteria"/>
                        <column property="requirements"/>
                    </columns>
                </dataGrid>
                <hbox id="lookupActions" visible="false">
                    <button id="selectBtn" action="selectAction"/>
                    <button id="discardBtn" action="discardAction"/>
                </hbox>
            </vbox>
            <vbox id="detailsLayout" height="100%">
                <formLayout id="form" dataContainer="toxicHarzadRequirementsDc">
                    <textField id="chemicalOrMaterialField" property="chemicalOrMaterial"/>
                    <textField id="criteriaField" property="criteria"/>
                    <textField id="requirementsField" property="requirements"/>
                </formLayout>
                <hbox id="detailActions">
                    <button id="saveBtn" text="msg:///actions.Save" icon="CHECK" themeNames="primary"/>
                    <button id="cancelBtn" text="msg:///actions.Cancel" icon="BAN"/>
                </hbox>
            </vbox>
        </formLayout>
    </layout>
</view>

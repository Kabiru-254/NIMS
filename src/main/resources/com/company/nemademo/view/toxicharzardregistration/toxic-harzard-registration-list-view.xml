<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://toxicHarzardRegistrationListView.title"
      focusComponent="toxicHarzardRegistrationsDataGrid">
    <data>
        <collection id="toxicHarzardRegistrationsDc"
                    class="com.company.nemademo.entity.ToxicHarzardRegistration">
            <fetchPlan extends="_base">
                <property name="toxicMaterial" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="toxicHarzardRegistrationsDl" readOnly="true">
                <query>
                    <![CDATA[select e from ToxicHarzardRegistration e]]>
                </query>
            </loader>
        </collection>
        <instance id="toxicHarzardRegistrationDc"
                  class="com.company.nemademo.entity.ToxicHarzardRegistration">
            <fetchPlan extends="_base">
                <property name="toxicMaterial" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="toxicHarzardRegistrationDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout padding="false">
        <formLayout classNames="master-detail-layout" height="100%">
            <vbox id="listLayout" height="100%">
                <genericFilter id="genericFilter"
                               dataLoader="toxicHarzardRegistrationsDl">
                    <properties include=".*"/>
                </genericFilter>
                <hbox id="buttonsPanel" classNames="buttons-panel">
                    <button id="createBtn" action="toxicHarzardRegistrationsDataGrid.create"/>
                    <button id="editBtn" action="toxicHarzardRegistrationsDataGrid.edit"/>
                    <button id="removeBtn" action="toxicHarzardRegistrationsDataGrid.remove"/>
                    <simplePagination id="pagination" dataLoader="toxicHarzardRegistrationsDl"/>
                </hbox>
                <dataGrid id="toxicHarzardRegistrationsDataGrid"
                          width="100%"
                          minHeight="20em"
                          dataContainer="toxicHarzardRegistrationsDc"
                          columnReorderingAllowed="true">
                    <actions>
                        <action id="create" type="list_create"/>
                        <action id="edit" type="list_edit"/>
                        <action id="remove" type="list_remove"/>
                    </actions>
                    <columns resizable="true">
                        <column property="toxicMaterial"/>
                        <column property="referenceNumber"/>
                    </columns>
                </dataGrid>
                <hbox id="lookupActions" visible="false">
                    <button id="selectBtn" action="selectAction"/>
                    <button id="discardBtn" action="discardAction"/>
                </hbox>
            </vbox>
            <vbox id="detailsLayout" height="100%">
                <formLayout id="form" dataContainer="toxicHarzardRegistrationDc">
                    <entityPicker id="toxicMaterialField" property="toxicMaterial">
                        <actions>
                            <action id="entityLookup" type="entity_lookup"/>
                            <action id="entityClear" type="entity_clear"/>
                        </actions>
                    </entityPicker>
                    <textField id="referenceNumberField" property="referenceNumber"/>
                </formLayout>
                <hbox id="detailActions">
                    <button id="saveBtn" text="msg:///actions.Save" icon="CHECK" themeNames="primary"/>
                    <button id="cancelBtn" text="msg:///actions.Cancel" icon="BAN"/>
                </hbox>
            </vbox>
        </formLayout>
    </layout>
</view>

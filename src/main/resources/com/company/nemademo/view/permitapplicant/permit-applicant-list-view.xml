<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://permitApplicantListView.title"
      focusComponent="permitApplicantsDataGrid">
    <data>
        <collection id="permitApplicantsDc"
                    class="com.company.nemademo.entity.PermitApplicant">
            <fetchPlan extends="_base"/>
            <loader id="permitApplicantsDl" readOnly="true">
                <query>
                    <![CDATA[select e from PermitApplicant e]]>
                </query>
            </loader>
        </collection>
        <instance id="permitApplicantDc"
                  class="com.company.nemademo.entity.PermitApplicant">
            <fetchPlan extends="_base"/>
            <loader id="permitApplicantDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout padding="false">
        <formLayout classNames="master-detail-layout" height="100%">
            <vbox id="listLayout" height="100%">
                <genericFilter id="genericFilter"
                               dataLoader="permitApplicantsDl">
                    <properties include=".*"/>
                </genericFilter>
                <hbox id="buttonsPanel" classNames="buttons-panel">
                    <button id="createBtn" action="permitApplicantsDataGrid.create"/>
                    <button id="editBtn" action="permitApplicantsDataGrid.edit"/>
                    <button id="removeBtn" action="permitApplicantsDataGrid.remove"/>
                    <simplePagination id="pagination" dataLoader="permitApplicantsDl"/>
                </hbox>
                <dataGrid id="permitApplicantsDataGrid"
                          width="100%"
                          minHeight="20em"
                          dataContainer="permitApplicantsDc"
                          columnReorderingAllowed="true">
                    <actions>
                        <action id="create" type="list_create"/>
                        <action id="edit" type="list_edit"/>
                        <action id="remove" type="list_remove"/>
                    </actions>
                    <columns resizable="true">
                        <column property="applicantType"/>
                        <column property="firstName"/>
                        <column property="lastName"/>
                        <column property="idNumberOrPassportNumber"/>
                        <column property="postalAddress"/>
                        <column property="residence"/>
                        <column property="organizationName"/>
                        <column property="kraPin"/>
                    </columns>
                </dataGrid>
                <hbox id="lookupActions" visible="false">
                    <button id="selectBtn" action="selectAction"/>
                    <button id="discardBtn" action="discardAction"/>
                </hbox>
            </vbox>
            <vbox id="detailsLayout" height="100%">
                <formLayout id="form" dataContainer="permitApplicantDc">
                    <select id="applicantTypeField" property="applicantType"/>
                    <textField id="firstNameField" property="firstName"/>
                    <textField id="lastNameField" property="lastName"/>
                    <textField id="idNumberOrPassportNumberField" property="idNumberOrPassportNumber"/>
                    <textField id="postalAddressField" property="postalAddress"/>
                    <textField id="residenceField" property="residence"/>
                    <textField id="organizationNameField" property="organizationName"/>
                    <textField id="kraPinField" property="kraPin"/>
                </formLayout>
                <hbox id="detailActions">
                    <button id="saveBtn" text="msg:///actions.Save" icon="CHECK" themeNames="primary"/>
                    <button id="cancelBtn" text="msg:///actions.Cancel" icon="BAN"/>
                </hbox>
            </vbox>
        </formLayout>
    </layout>
</view>
